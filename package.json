{
  "name": "shapezmods",
  "version": "1.0.0",
  "description": "Shapez mods.",
  "homepage": "https://elspeth.xyz/shapez-mods",
  "author": "Elspeth",
  "type": "module",
  "scripts": {
    "setup-----------------------------------------": "",
    "setup#comment": "Commands setting up the dev system and shapez runner.",
    "setup": "run-s setup:*",
    "setup:clone-shapez": "node scripts/initShapez/cloneShapez.ts",
    "setup:init-shapez": "node scripts/initShapez/initShapez.ts",
    "setup:shapez-types": "node scripts/initShapez/buildShapezTypes.ts",
    "setup:build-shapez": "node scripts/initShapez/buildShapez.ts",
    "setup:paths": "node scripts/workspace/initPaths.ts",
    "build-----------------------------------------": "",
    "build#comment": "Build mods for final game",
    "build:prod": "node scripts/workspace/buildMods.ts",
    "build:dev": "DEV=true node scripts/workspace/buildMods.ts",
    "fix-------------------------------------------": "",
    "fix#comment": "Run linting and formatting",
    "fix": "run-p fix:*",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "check-----------------------------------------": "",
    "check#comment": "Run lint and format checking.",
    "check": "run-p check:*",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint --deny-warnings",
    "dev-------------------------------------------": "",
    "dev#comment": "Run build in dev shapez environment",
    "dev": "run-s dev:*",
    "dev:prepare": "npm run build:dev",
    "dev:launch": "node scripts/workspace/runDev.ts",
    "selectmods": "node scripts/workspace/selectMods.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/prompts": "2.4.9",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "prompts": "2.4.2",
    "rolldown": "1.2.14",
    "typescript": "7.0.2"
  }
}
