{
  "extends": "./paths.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "outDir": "dist",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,

    "strict": true,
    "alwaysStrict": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "types": ["node"]
  },
  "include": ["src", "scripts", "z_mods"],
  "exclude": ["shapez"]
}
